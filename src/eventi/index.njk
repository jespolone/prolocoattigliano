---
layout: base.njk
title: Eventi
section: eventi
eleventyExcludeFromCollections: true
---
<div class="container events-page">
  <div class="page-head">
    <h1>Eventi</h1>
    <p>Gli appuntamenti organizzati dalla Pro Loco Attigliano.</p>
  </div>
  <div class="cards">
    {% asyncEach e in collections.eventiTutti %}
      {% include "event-card.njk" %}
    {% else %}
      <div class="empty-state"><p>Nessun evento in programma. Seguici su <a href="{{ site.instagram }}" target="_blank" rel="noopener">Instagram</a> per gli aggiornamenti.</p></div>
    {% endeach %}
  </div>
</div>
